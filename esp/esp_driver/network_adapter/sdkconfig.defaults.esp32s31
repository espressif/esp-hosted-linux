# BT controller configuration.
# ESP32-S31 supports BR/EDR + BLE concurrently; Linux sees one dual-mode HCI.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CTRL_HCI_INTERFACE_USE_RAM=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32s31.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.esp32s31.csv"


# Optional controller UART HCI alternative (Hosted uses VHCI by default).
# To use UART instead, disable CONFIG_BT_CTRL_HCI_INTERFACE_USE_RAM and enable:
#CONFIG_BT_CTRL_HCI_INTERFACE_USE_UART=y
#CONFIG_BT_CTRL_HCI_UART_PORT=1
#CONFIG_BT_CTRL_HCI_UART_TX_PIN=13
#CONFIG_BT_CTRL_HCI_UART_RX_PIN=12
#CONFIG_BT_CTRL_HCI_UART_FLOWCTRL=n
#CONFIG_BT_CTRL_HCI_UART_BAUD=921600

CONFIG_ESP32_WIFI_NVS_ENABLED=

CONFIG_BT_BTC_TASK_STACK_SIZE=4096
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_ACT_SCAN_REP_ADV_SCAN=y
CONFIG_BT_GATTC_CONNECT_RETRY_COUNT=20


CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BT_LE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_LE_ACL_BUF_COUNT=8
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=16
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=6
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# TinyUSB vendor bulk support used by the ESP32-S31 USB transport.
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=8192
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=16384

# S31 product firmware includes every supported radio service. Runtime service
# selection controls activation; no separate RCP product image/config exists.
# RCP over the selected ESP-Hosted USB/SDIO/SPI bus is the recommended/default
# product topology. Dedicated UART RCP below is an explicit customer override.
CONFIG_ESP_HOSTED_RCP=y
CONFIG_ESP_HOSTED_RCP_RX_QUEUE_SIZE=16
CONFIG_ESP_HOSTED_RCP_LOOPBACK_TEST=n
CONFIG_ESP_HOSTED_RCP_OPENTHREAD=y
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_RCP_CUSTOM=y
CONFIG_OPENTHREAD_NCP_VENDOR_HOOK=y
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_DIAG=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Optional fully separated radio-host interfaces (explicit opt-in; not default):
# - keep Wi-Fi on ESP-Hosted
# - put Bluetooth HCI on (for example) UART1
# - put Thread Spinel RCP on a different UART (UART2 by default)
#
# To select dedicated Thread UART RCP, override the default Hosted RCP choice:
# CONFIG_ESP_HOSTED_RCP=n
# CONFIG_OPENTHREAD_RCP_CUSTOM=n
# CONFIG_OPENTHREAD_RCP_UART=y
# CONFIG_ESP_THREAD_RCP_UART=y
# CONFIG_ESP_THREAD_RCP_UART_PORT=2
# CONFIG_ESP_THREAD_RCP_UART_BAUD=460800
# CONFIG_ESP_THREAD_RCP_UART_TX_PIN=-1
# CONFIG_ESP_THREAD_RCP_UART_RX_PIN=-1
